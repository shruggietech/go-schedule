{
  "name": "go-schedule-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && next dev",
    "build": "node scripts/prepare.mjs && next build && node scripts/postbuild.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "postinstall": "node scripts/prepare.mjs && fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.17.10",
    "fumadocs-ui": "16.17.10",
    "mermaid": "12.3.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "next-themes": "0.4.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fumadocs-mdx": "15.4.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  }
}
